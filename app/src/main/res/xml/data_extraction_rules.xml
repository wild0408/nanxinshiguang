<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则。云备份与设备间迁移都要排除用设备专属
  AndroidKeyStore 密钥加密的密文文件（WebDAV 密码、门户凭据、劳动积分缓存），
  否则恢复后无法解密；课表数据库与设置保持默认备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/api_config.preferences_pb" />
        <exclude domain="file" path="datastore/portal_auth.preferences_pb" />
        <exclude domain="file" path="datastore/labor_score.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/api_config.preferences_pb" />
        <exclude domain="file" path="datastore/portal_auth.preferences_pb" />
        <exclude domain="file" path="datastore/labor_score.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
